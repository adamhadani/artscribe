# Agent and tooling scratch
# Brainstorming companion scratch, SDD ledger/briefs, harness worktrees
.superpowers/
.claude/

# Generated Xcode project — project.yml is the source of truth
*.xcodeproj/
*.xcworkspace/
# Even a generated project collects per-user state beside it.
xcuserdata/
*.xcuserstate

# Build products of `make app` / `make dist`. The bundle and the archive are
# outputs, never sources; the icon is generated from App/GenerateIcon.swift.
*.app/
App/Artscribe.icns
App/Artscribe.iconset/
dist/

# SwiftPM. `Package.resolved` is ignored because this package pins no versioned
# dependencies — Rubber Band comes from the system, not from SwiftPM.
.build/
.swiftpm/
Package.resolved

# Acceptance harness output.
#
# A run drops around thirty screenshots. They used to land loose in the
# repository root, untracked *and* unignored, which is one `git add -A` away
# from being committed — the accident CLAUDE.md's "never `git add -A`" rule was
# written after. The harness now defaults `--out` to `.artscribe-out`; the
# numbered patterns are belt and braces for an older binary, or for anyone
# passing `--out .`.
.artscribe-out/
/[0-9][0-9]-*.png
/[0-9][0-9][a-z]-*.png

# Local test media (large, copyrighted — see ARTSCRIBE_TEST_MEDIA_DIR).
Tests/Media/

# Audio anywhere else, because "never commit audio over 100 KB" is a rule the
# pre-commit hook enforces and this is the cheaper place to catch it. The
# fixtures are the deliberate exception: a handful of sub-100 KB generated tones
# from Tests/Fixtures/generate.sh, committed so the suite runs on a clean
# checkout.
*.wav
*.flac
*.mp3
*.m4a
*.aac
*.ogg
*.opus
*.aiff
*.caf
*.ape
!Tests/Fixtures/**

# Session sidecars, which get written beside audio while testing by hand
*.artscribe

# macOS
.DS_Store
.AppleDouble

# Editors
*.swp
*~
.idea/
.vscode/

# Crash logs and profiling output
*.crash
*.trace
*.xcresult/

# direnv
.envrc

# Credentials, keys and certificates — never committed, and named here so an
# accident is prevented rather than merely regretted. The signing setup involves
# a .p12 (the Developer ID private key, which cannot be recreated) and a .p8
# (the App Store Connect API key); both get exported to disk during setup, and
# both are exactly the sort of thing that lands in a repo root "just for a
# minute". `detect-private-key` in .pre-commit-config.yaml is the second line.
*.p12
*.pfx
*.p8
*.pem
*.key
*.cer
*.crt
*.der
*.keystore
*.jks
*.mobileprovision
AuthKey_*
id_rsa*
id_ed25519*
.env
.env.*
!.env.example
